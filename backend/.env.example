PORT=4000
# Frontend origin(s), comma-separated. No trailing slash.
# Local: http://localhost:5173
# Hosted: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://safetrip:safetrip@localhost:5432/safetrip"
# Hosted (Render/Neon): paste the Postgres URL. Do not use SQLite — the free Render disk is wiped on sleep, which deletes accounts, contacts, and history.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=development
APP_CONTACT=safetrip@localhost

# Optional: Google Directions with live traffic (server only — never put this in the frontend)
# Enable the Directions API on Google Cloud and paste the key here.
GOOGLE_MAPS_API_KEY=

# Twilio trial SMS (recommended for this project).
# Console: https://console.twilio.com
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx   (the Twilio number, with country code)
# Trial accounts can only text Verified Caller IDs. Add each contact's +91 number there.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SAFTRP
MSG91_TEMPLATE_ID=
