PORT=4000
# Frontend origin(s), comma-separated. No trailing slash.
# Local: http://localhost:5173
# Hosted: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=development
APP_CONTACT=safetrip@localhost

# Optional: Google Directions with live traffic (server only — never put this in the frontend)
# Enable the Directions API on Google Cloud and paste the key here.
GOOGLE_MAPS_API_KEY=

# SMS to trusted contacts. Use "twilio" or "msg91". Leave as "none" to skip sending (trips still work).
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SAFTRP
MSG91_TEMPLATE_ID=
